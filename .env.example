# JumpServer Core URL, including scheme. Do not include a trailing slash.
JUMPSERVER_URL=https://jms.example.com

# Default organization. JumpServer's built-in Default org is:
# 00000000-0000-0000-0000-000000000002
JUMPSERVER_ORG_ID=00000000-0000-0000-0000-000000000002

# Preferred: Access Key created in JumpServer personal settings.
JUMPSERVER_ACCESS_KEY_ID=
JUMPSERVER_ACCESS_KEY_SECRET=

# Alternative: Private Token (`Authorization: Token ...`) or Bearer token.
# JUMPSERVER_TOKEN=

# Optional KoKo SSH endpoint override. When unset, the plugin reads host/port
# from the connection-token client-url response.
# JUMPSERVER_KOKO_HOST=
# JUMPSERVER_KOKO_PORT=2222
