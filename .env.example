# Template only. Copy into $DSH_HOME/.env
# (macOS/Linux: ~/.dsh/.env  Windows: %USERPROFILE%\.dsh\.env)
# dsh plugin add does not install this file.

# JumpServer Core URL, including scheme. Do not include a trailing slash.
JUMPSERVER_URL=https://jms.example.com

# Organization UUID (X-JMS-ORG). Omit to use JumpServer Default org.
JUMPSERVER_ORG_ID=00000000-0000-0000-0000-000000000002

# Access Key created in JumpServer personal settings.
JUMPSERVER_ACCESS_KEY_ID=
JUMPSERVER_ACCESS_KEY_SECRET=

# Register host create/update/delete tools. Default false.
JUMPSERVER_ENABLE_ASSET_ADMIN=false

# Allow INSERT/UPDATE/DELETE on database sessions. Default false (query only).
JUMPSERVER_ENABLE_DB_WRITE=false
