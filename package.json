{
  "name": "@jumpserver-east/jumpserver-dsh",
  "version": "0.1.2",
  "description": "DeepSeek Harness plugin: manage JumpServer assets and operate on them through KoKo",
  "license": "MIT",
  "author": "lettimepassby <86416409@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jumpserver-east/jumpserver-dsh.git"
  },
  "bugs": {
    "url": "https://github.com/jumpserver-east/jumpserver-dsh/issues"
  },
  "homepage": "https://github.com/jumpserver-east/jumpserver-dsh#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "jumpserver",
    "koko",
    "pam"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#ssh2": "./vendor/ssh2/lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "vendor/ssh2"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "dependencies": {
    "asn1": "^0.2.6",
    "bcrypt-pbkdf": "^1.0.2",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^24.3.0",
    "@types/ssh2": "^1.15.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
